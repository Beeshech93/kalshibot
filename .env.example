# ==============================================================
# BTC SCALPING AI - Configuración de Variables de Entorno
# ==============================================================

# Entorno de Kalshi
# Producción: https://api.elections.kalshi.com/trade-api/v2
# Demo: https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2

# Serie objetivo de Kalshi (Serie inicial: KXBTC15M; fallbacks: KXBTCH, KXBTCD, KXBTC)
KALSHI_TARGET_SERIES=KXBTC15M
KALSHI_FALLBACK_SERIES=KXBTCH,KXBTCD,KXBTC

# Autenticación Kalshi (Opcional para lectura pública de mercados)
# Si se cuenta con API Key RSA:
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# O login tradicional por email (Demo/Legacy):
KALSHI_EMAIL=
KALSHI_PASSWORD=

# Telegram Bot API (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IDs de usuarios autorizados separados por coma (e.g. 123456789,987654321)
TELEGRAM_AUTHORIZED_USERS=

# Parámetros del Sistema
ANALYSIS_INTERVAL_MINUTES=15
MIN_CONFIDENCE_SCORE=60
MODE=SOLO_SEÑALES

# Dashboard Web
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=False

# Base de datos
DATABASE_PATH=data/btc_scalping.db

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
